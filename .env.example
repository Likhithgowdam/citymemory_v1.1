# CityMemory settings. Lines starting with # are ignored.

# Google Gemini key from https://aistudio.google.com/apikey
# Leave empty to use the built-in offline rules (the demo works either way).
GEMINI_API_KEY=

# Optional: which Gemini model to use
# GEMINI_MODEL=gemini-2.5-flash

# Fixes "today" for the demo so the numbers match our document
# (drain SWD-151-07 "last repaired 40 days ago"). Remove this line to use the real date.
CITYMEMORY_TODAY=2026-10-30

# Port for the web page
PORT=8000
